{
  "name": "nem-api-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker for the NEM dispatch SCADA API (nem.api modernization)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build:css": "tailwindcss -i tailwind.css -o public/assets/styles.css --minify",
    "deploy": "wrangler deploy",
    "check": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "seed:generate": "node scripts/generate-seed.mjs",
    "refresh:generate": "node scripts/refresh-generators.mjs",
    "refresh:check": "node scripts/refresh-generators.mjs --self-check",
    "refresh:local": "wrangler d1 execute nem-api-db --local --file=refresh-upsert.sql",
    "refresh:remote": "wrangler d1 execute nem-api-db --remote --file=refresh-upsert.sql",
    "migrate:local": "wrangler d1 migrations apply nem-api-db --local",
    "migrate:remote": "wrangler d1 migrations apply nem-api-db --remote"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.7",
    "@cloudflare/workers-types": "^5.20260721.1",
    "@tailwindcss/cli": "^4.3.3",
    "daisyui": "^5.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.113.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "uplot": "1.6.32"
  }
}
