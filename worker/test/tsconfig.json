{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "vitest"],
    // vitest's tinybench .d.ts clashes with workers-types' global EventTarget;
    // node_modules declarations are not ours to typecheck.
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../src/**/*.ts"]
}
